Subject: [PATCH] The Brick's own boot command falls back to slot a's files

boot.scr boots the slot bootstate.txt names, from that slot's folder on the
boot partition (/a or /b; board/brick/boot-slot.cmd). When boot.scr fails,
U-Boot's own boot command carried on with the uncompressed Image, the
initramfs and the device tree at the partition's root, which a card with
system slots no longer has there: it now loads slot a's, from /a.

---
--- a/configs/trimui-brick_defconfig
+++ b/configs/trimui-brick_defconfig
@@ -29,7 +29,7 @@
 CONFIG_BOOTSTAGE_FDT=y
 CONFIG_BOOTDELAY=0
 CONFIG_USE_BOOTCOMMAND=y
-CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:1 ${kernel_addr_r} Image && load mmc 0:1 ${ramdisk_addr_r} initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
+CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:1 ${kernel_addr_r} a/Image && load mmc 0:1 ${ramdisk_addr_r} a/initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} a/brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
 CONFIG_LAST_STAGE_INIT=y
 CONFIG_SPL_I2C=y
 CONFIG_HUSH_PARSER=y
