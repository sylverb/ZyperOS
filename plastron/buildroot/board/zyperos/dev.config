# Every build but a release's (scripts/build.sh merges this unless
# PLASTRON_RELEASE): the compiler goes through ccache, its cache shared by
# every output in /work/ccache, so a package built again for a changed input
# takes its unchanged objects from it. A release builds clean without it
# (scripts/release.sh), as before.
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=5G"
BR2_CCACHE_USE_BASEDIR=y
