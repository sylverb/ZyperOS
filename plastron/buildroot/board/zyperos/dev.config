# A development build's (make DEV=1; scripts/build.sh merges this then, and
# never for a release): the compiler goes through ccache, its cache shared by
# every output in /work/ccache, so a package built again for a changed input
# takes its unchanged objects from it.
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=5G"
BR2_CCACHE_USE_BASEDIR=y
