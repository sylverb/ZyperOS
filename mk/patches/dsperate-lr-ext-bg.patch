++      const u32 moff = ((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)) * 2;
++      u16 tile;
++      if (map_run) std::memcpy(&tile, map_run + moff, 2); else tile = vram_fetch16(vm, vv, tilemap + moff);
+       u32 tx = (fx >> 8) & 7, ty = (fy >> 8) & 7;
+       if (tile & (1 << 10)) tx = 7 - tx;
+       if (tile & (1 << 11)) ty = 7 - ty;
+-      const u8 idx = vram_fetch8(vm, vv, tileset + ((tile & 0x3FF) << 6) + (ty << 3) + tx);
