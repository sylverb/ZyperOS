+diff --git a/src/core/gpu/vram_map.h b/src/core/gpu/vram_map.h
+index b9fc8d59..82552d8d 100644
+--- a/src/core/gpu/vram_map.h
++++ b/src/core/gpu/vram_map.h
+@@ -79,4 +79,20 @@ inline u16 vram_fetch16(const VramMap& vm, const VramView& v, u32 a) {
+   u16 r; std::memcpy(&r, p + (a & (VramView::BLOCK - 1)), 2); return r;
+ }
+ 
++// The `len` bytes at `addr` as one host range, for a renderer that indexes a
++// whole bitmap, map or tileset per pixel: when every block they cover is
++// backed by exactly one bank and those blocks lie back to back in host memory
++// (one bank's blocks always do), the range starts here; else nullptr, and the
++// caller fetches per pixel. The range lies inside the view, so the view's
++// wrap never applies to it.
++inline const u8* vram_run(const VramView& v, u32 addr, u32 len) {
++  if (len == 0 || addr >= v.size || len > v.size - addr) return nullptr;
++  const u32 b0 = addr / VramView::BLOCK, b1 = (addr + len - 1) / VramView::BLOCK;
++  const u8* p0 = v.ptr[b0];
++  if (!p0) return nullptr;
++  for (u32 b = b0 + 1; b <= b1; ++b)
++    if (v.ptr[b] != p0 + (b - b0) * VramView::BLOCK) return nullptr;
++  return p0 + (addr & (VramView::BLOCK - 1));
++}
++
+ } // namespace ds::gpu
