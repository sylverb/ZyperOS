+@@ -472,11 +476,12 @@ void Engine2D::draw_bg_extended(u32 line, int bg) {
+       if ((fx & ofx) || (fy & ofy)) continue;
+       const u32 off = (((fy & ymask) >> 8) << yshift) + ((fx & xmask) >> 8);
+       if (direct) {
+-        const u16 c = vram_fetch16(vm, vv, base + (off << 1));
++        u16 c;
++        if (run) std::memcpy(&c, run + (off << 1), 2); else c = vram_fetch16(vm, vv, base + (off << 1));
+         if (!(c & 0x8000)) continue;
