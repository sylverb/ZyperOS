+ * buttons on every other retro_run, so a press that began on the one it
+ * yields on was a btnp the cart never saw, and the next frame's had it as
+ * held only (short taps lost; a long one came late, by btnp's repeat). */
+static uint32_t stubFrame;
+static bool stubRead = true;
+
 void setInputState(uint8_t kDown, uint8_t kHeld, int16_t mouseX, int16_t mouseY, uint8_t mouseBtns) {
-    stubCurrKDown = kDown;
+    stubCurrKDown = stubRead ? kDown : (uint8_t)(stubCurrKDown | kDown);
+    stubRead = false;
+    stubFrame = stubFrame + 1 ? stubFrame + 1 : 1;
     stubCurrKHeld = kHeld;
     stubMouseX = mouseX;
     stubMouseY = mouseY;
@@ -66,7 +76,8 @@ void Host::forceStretch(StretchOption newStretch) {
 
 
 InputState_t Host::scanInput(){
-    return InputState_t {stubCurrKDown, stubCurrKHeld, stubMouseX, stubMouseY, stubMouseBtns, stubCurrKBdown, stubCurrKBkey};
