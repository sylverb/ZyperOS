diff --git a/source/vm.cpp b/source/vm.cpp
index f01df8b..35629ce 100644
--- a/source/vm.cpp
+++ b/source/vm.cpp
@@ -1193,6 +1193,14 @@ void Vm::api_srand(fix32 seed)
 void Vm::update_buttons() {
     //get button states from hardware
     auto inputState = _host->scanInput();
+
+    // Once a host frame: a 30 fps cart's _update and its flip() both read,
+    // and counting a held button twice made btnp repeat at half the delay
+    // and twice the rate. A host that counts no frames (0) reads every time.
+    if (inputState.frame) {
+        if (inputState.frame == _inputFrame) return;
+        _inputFrame = inputState.frame;
+    }
     
     // If we just resumed from pause menu, clear input so the button press
     // that closed the menu doesn't get passed to the cart.
