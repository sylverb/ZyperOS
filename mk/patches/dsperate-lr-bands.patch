diff --git a/patches/0004-two-bands-under-layout.patch b/patches/0004-two-bands-under-layout.patch
new file mode 100644
index 0000000..42067ae
--- /dev/null
+++ b/patches/0004-two-bands-under-layout.patch
@@ -0,0 +1,32 @@
+diff --git a/src/core/gpu/render3d.cpp b/src/core/gpu/render3d.cpp
+index 65e5ceea..ae8d8512 100644
+--- a/src/core/gpu/render3d.cpp
++++ b/src/core/gpu/render3d.cpp
+@@ -3451,16 +3451,21 @@ bool Renderer3D::steal_bins(u64 gen, u32 upto) {
+ u32 Renderer3D::band_count(u32 polygons) {
+   if (polygons < 2) return 0;
+   // Three on three+ cores, two on two; a single core draws inline. The thread
+-  // layout pins one beside each 2D engine and the third on the aux core; the
+-  // emulation thread steals bins as it reaches them. The third matters when
+-  // the raster has a deadline: Guitar Hero: On Tour reads its capture of the
+-  // 3D layer back at every VBlank, and with CPU AA two bands missed it in 16%
+-  // of frames (RG DS Plus), three in 0.8%; scenes without that deadline are
+-  // unchanged, audio on the aux core unaffected.
++  // layout pins one beside each 2D engine; the emulation thread steals bins
++  // as it reaches them. Upstream puts a third on the aux core under the
++  // layout too, for a raster with a deadline (Guitar Hero: On Tour reads its
++  // capture of the 3D layer back at every VBlank). In a libretro frontend
++  // the aux core is the frontend's: its present, audio and input threads run
++  // there at normal priority, and a band at the workers' SCHED_RR pre-empts
++  // them. On a GKD Pixel 2 (four Cortex-A35, ZyperOS's Diatom) that cost the
++  // panel 3 to 6 frames a second in a Mario Kart DS race and a Pokemon Black
++  // forest, with the core's own frame time unchanged; two bands, as before,
++  // keep both at 59.8 fps.
+   const u32 cores = host_cores();
+   // DS_R3D_BANDS=n: that many (1..8), for measuring the split.
+   static const u32 forced = [] { const char* e = std::getenv("DS_R3D_BANDS"); const int n = e ? std::atoi(e) : 0; return n >= 1 && n <= 8 ? static_cast<u32>(n) : 0u; }();
+   if (forced) return forced;
++  if (thread_layout_on() && cores >= 4) return 2;
+   return cores >= 3 ? 3 : cores >= 2 ? 2 : 0;
+ }
+ 
