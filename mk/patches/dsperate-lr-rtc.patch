+// The DS clock (its RTC), at the handheld's local time. DSperate leaves it
+// off unless the frontend starts it (Io::start_rtc_clock), for determinism,
+// and this wrapper never started it: off, it stays at 2000-01-01 00:00:00
+// and never ticks, so a game that shows the time showed 0:00 for ever
+// (Pokemon Black on my Pixel 2). Started, it is set from the host's local
+// time (localtime, so TZ, which Diatom sets from the launcher's zone before
+// the game loads) and counts emulated seconds from there. Emulated time is
+// not the host's: it stands still while the frontend pauses (its menu) or the
+// handheld sleeps, runs slow when frames run late and fast in fast forward,
+// and a state brings back the time it was saved at. So the clock is set to
+// the host's again after a state loads and after a reset, and whenever
+// emulated time since it was set is a second or more off the host's, looked
+// at before every frame: a real DS's clock keeps the time while no game runs,
+// and DSperate's own frontend sets it again as the lid opens
+// (Io::resync_rtc_clock). It then reads at most two seconds behind the host's
+// time (it counts whole seconds from a time it floors) and one ahead.
+double rtc_host;   // the host's time when the clock was last set, in seconds
+ds::u64 rtc_emu;   // the emulated time then, in ARM9 cycles
+
+double host_time() {
+  timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  return double(ts.tv_sec) + ts.tv_nsec / 1e9;
+}
+
+void rtc_mark() {
+  rtc_host = host_time();
+  rtc_emu = nds->sched.now();
+}
+
+void rtc_set() {
+  nds->io.resync_rtc_clock();
+  rtc_mark();
+}
+
+void rtc_follow() {
+  const double emu = double(static_cast<long long>(nds->sched.now() - rtc_emu)) / ds::ARM9_CLOCK_HZ;
+  const double off = host_time() - rtc_host - emu;
+  if (off >= 1.0 || off <= -1.0) rtc_set();
+}
